{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darwin-mfc.local/schemas/epistemic-firewall-receipt.v2.json",
  "title": "Darwin Sounio Epistemic Firewall Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "modelVersion",
    "status",
    "generatedAt",
    "hashes",
    "gates",
    "signature",
    "refusalReasons"
  ],
  "properties": {
    "schemaVersion": { "const": "darwin.sounio.epistemic-firewall-receipt.v2" },
    "policyVersion": { "type": "string", "minLength": 1 },
    "modelVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["refused", "experimental", "calibrated"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "hashes": { "type": "object" },
    "gates": { "type": "object" },
    "signature": { "type": ["string", "null"] },
    "refusalReasons": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
