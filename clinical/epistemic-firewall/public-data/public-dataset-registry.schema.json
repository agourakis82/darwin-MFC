{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darwin-mfc.local/schemas/public-dataset-registry.v1.json",
  "title": "Darwin-Sounio public clinical dataset registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "reviewedAt",
    "targetSetting",
    "invariants",
    "datasets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "darwin.sounio.public-clinical-dataset-registry.v1"
    },
    "status": {
      "const": "research-feasibility-only"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date"
    },
    "targetSetting": {
      "const": "APS/SUS pediatric respiratory pilot"
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apsCalibrationAuthorized",
        "clinicalActivationAuthorized",
        "patientRowsStoredInRepository",
        "credentialsStoredInRepository",
        "unknownNeverCoercedToAbsent"
      ],
      "properties": {
        "apsCalibrationAuthorized": { "const": false },
        "clinicalActivationAuthorized": { "const": false },
        "patientRowsStoredInRepository": { "const": false },
        "credentialsStoredInRepository": { "const": false },
        "unknownNeverCoercedToAbsent": { "const": true }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/dataset"
      }
    }
  },
  "$defs": {
    "featureMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featureId",
        "fidelity",
        "sourceFields",
        "rule",
        "missingMapsTo",
        "apsCalibrationEligible"
      ],
      "properties": {
        "featureId": { "type": "string" },
        "fidelity": {
          "enum": ["exact", "positive-only", "proxy", "unavailable"]
        },
        "sourceFields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rule": { "type": "string", "minLength": 1 },
        "missingMapsTo": { "const": -1 },
        "apsCalibrationEligible": { "const": false }
      }
    },
    "conditionMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditionId",
        "fidelity",
        "sourceFields",
        "rule",
        "nineClassCalibrationEligible"
      ],
      "properties": {
        "conditionId": { "type": "string" },
        "fidelity": {
          "enum": ["exact-subset", "diagnosis-code-proxy", "syndromic-proxy"]
        },
        "sourceFields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "rule": { "type": "string", "minLength": 1 },
        "nineClassCalibrationEligible": { "const": false }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probeId", "method", "url", "essential"],
      "properties": {
        "probeId": { "type": "string", "minLength": 1 },
        "method": { "enum": ["HEAD", "RANGE_HEADER"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "essential": { "type": "boolean" },
        "delimiter": { "type": "string", "minLength": 1, "maxLength": 1 },
        "requiredColumns": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "title",
        "authority",
        "country",
        "officialDatasetUrl",
        "documentationUrls",
        "license",
        "access",
        "population",
        "role",
        "allowedUses",
        "forbiddenUses",
        "selectionBias",
        "featureMappings",
        "conditionMappings",
        "probes"
      ],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "minLength": 2 },
        "officialDatasetUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "documentationUrls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "license": { "type": "string", "minLength": 1 },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "patientLevel",
            "retrievalStatus",
            "credentialsStored",
            "snapshot",
            "unitOfAnalysis"
          ],
          "properties": {
            "level": { "enum": ["public", "public-metadata"] },
            "patientLevel": { "type": "boolean" },
            "retrievalStatus": { "type": "string", "minLength": 1 },
            "credentialsStored": { "const": false },
            "snapshot": { "type": "string", "minLength": 1 },
            "unitOfAnalysis": { "type": "string", "minLength": 1 }
          }
        },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "careSetting", "pediatricRecordsAvailable"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "careSetting": { "type": "string", "minLength": 1 },
            "pediatricRecordsAvailable": { "type": "boolean" }
          }
        },
        "role": {
          "enum": [
            "severity-safety-validation",
            "syndromic-development",
            "ambulatory-treatment-pattern-audit",
            "diagnosis-transportability-audit",
            "epidemiologic-context-only"
          ]
        },
        "allowedUses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "forbiddenUses": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string" }
        },
        "selectionBias": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "featureMappings": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/featureMapping" }
        },
        "conditionMappings": {
          "type": "array",
          "items": { "$ref": "#/$defs/conditionMapping" }
        },
        "probes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/probe" }
        }
      }
    }
  }
}
