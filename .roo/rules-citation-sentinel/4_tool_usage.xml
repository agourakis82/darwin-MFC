<?xml version="1.0" encoding="UTF-8"?>
<tool_usage>
  <overview>
    <title>Citation Sentinel - Tool Usage</title>
    <description>
      Estratégias de ferramentas e APIs para validação de citações.
    </description>
  </overview>

  <file_operations>
    <priority_order>
      <priority rank="1">Read - Ler arquivos de dados e referências</priority>
      <priority rank="2">Grep - Buscar citações [n] e claims</priority>
      <priority rank="3">Edit - Adicionar citações e referências</priority>
    </priority_order>

    <key_files>
      <file purpose="references">lib/data/references.ts</file>
      <file purpose="rastreamentos">lib/data/rastreamentos.ts</file>
      <file purpose="analise_critica">lib/data/analise-critica.ts</file>
      <file purpose="doencas">lib/data/doencas/*.ts</file>
      <file purpose="medicamentos">lib/data/medicamentos/*.ts</file>
      <file purpose="citation_component">app/components/Bibliography/InlineCitation.tsx</file>
      <file purpose="validator">app/components/Bibliography/ReferenceValidator.tsx</file>
    </key_files>
  </file_operations>

  <api_integrations>
    <api name="PubMed E-utilities">
      <description>Busca e validação de artigos científicos</description>
      <base_url>https://eutils.ncbi.nlm.nih.gov/entrez/eutils/</base_url>

      <endpoint name="esearch">
        <purpose>Buscar artigos por termo</purpose>
        <url>esearch.fcgi</url>
        <example_query>
          <![CDATA[
esearch.fcgi?db=pubmed&term=breast+cancer+screening+systematic+review&retmax=10&retmode=json&sort=relevance
          ]]>
        </example_query>
        <response_parsing>
          <![CDATA[
{
  "esearchresult": {
    "count": "1234",
    "idlist": ["12345678", "12345679", "12345680"]
  }
}
          ]]>
        </response_parsing>
      </endpoint>

      <endpoint name="efetch">
        <purpose>Obter metadados de artigo por PMID</purpose>
        <url>efetch.fcgi</url>
        <example_query>
          <![CDATA[
efetch.fcgi?db=pubmed&id=12345678&rettype=abstract&retmode=xml
          ]]>
        </example_query>
        <fields_to_extract>
          <field>ArticleTitle</field>
          <field>AuthorList</field>
          <field>Journal/Title</field>
          <field>PubDate/Year</field>
          <field>Volume</field>
          <field>Issue</field>
          <field>MedlinePgn (pages)</field>
          <field>ArticleIdList (DOI, PMID)</field>
        </fields_to_extract>
      </endpoint>

      <endpoint name="einfo">
        <purpose>Informações sobre o banco de dados</purpose>
        <url>einfo.fcgi?db=pubmed</url>
      </endpoint>

      <rate_limiting>
        <without_api_key>3 requests/second</without_api_key>
        <with_api_key>10 requests/second</with_api_key>
        <recommendation>Implementar delay de 350ms entre requests</recommendation>
      </rate_limiting>
    </api>

    <api name="CrossRef">
      <description>Validação de DOIs e metadados de publicações</description>
      <base_url>https://api.crossref.org/</base_url>

      <endpoint name="works_by_doi">
        <purpose>Obter metadados por DOI</purpose>
        <url>works/{doi}</url>
        <example>
          <![CDATA[
https://api.crossref.org/works/10.1001/jama.2020.5269
          ]]>
        </example>
        <validation>
          <success>HTTP 200 = DOI válido</success>
          <failure>HTTP 404 = DOI não encontrado</failure>
        </validation>
      </endpoint>

      <endpoint name="works_search">
        <purpose>Buscar artigos por título/autor</purpose>
        <url>works?query={terms}&amp;rows=5</url>
        <example>
          <![CDATA[
https://api.crossref.org/works?query=breast+cancer+screening&rows=5
          ]]>
        </example>
      </endpoint>

      <headers>
        <header name="User-Agent">Darwin-MFC/1.0 (mailto:contact@example.com)</header>
      </headers>

      <rate_limiting>
        <polite_pool>50 requests/second with User-Agent</polite_pool>
      </rate_limiting>
    </api>
  </api_integrations>

  <webfetch_prompts>
    <prompt name="validate_doi">
      <description>Validar DOI e extrair metadados</description>
      <template>
        <![CDATA[
Fetch the CrossRef API for DOI: {doi}
Extract and return:
1. Is the DOI valid? (yes/no)
2. Title
3. Authors (list)
4. Journal name
5. Year
6. Volume, issue, pages
7. Any issues or warnings
        ]]>
      </template>
    </prompt>

    <prompt name="search_citations">
      <description>Buscar citações para uma claim</description>
      <template>
        <![CDATA[
Search PubMed for recent systematic reviews or meta-analyses about:
"{claim_context}"

Return the top 5 most relevant results with:
- PMID
- Title
- Authors (first author et al)
- Journal
- Year
- Brief relevance assessment
        ]]>
      </template>
    </prompt>

    <prompt name="extract_guideline_citation">
      <description>Extrair informação de citação de página de guideline</description>
      <template>
        <![CDATA[
Extract citation information from this guideline page:
- Organization/Author
- Full title
- Publication date
- URL
- Access date (today)

Format as Vancouver style.
        ]]>
      </template>
    </prompt>
  </webfetch_prompts>

  <grep_patterns>
    <pattern name="find_uncited_numbers">
      <purpose>Encontrar números sem citação</purpose>
      <regex>\d+[,.]?\d*\s*(%|por\s*100\.?000|casos)[^[]*$</regex>
      <explanation>Números seguidos de unidades, não seguidos de [</explanation>
    </pattern>

    <pattern name="find_citations">
      <purpose>Encontrar todas citações inline</purpose>
      <regex>\[(\d+(?:,\s*\d+)*(?:-\d+)?)\]</regex>
      <explanation>Captura [1], [1,2], [1-3]</explanation>
    </pattern>

    <pattern name="find_reference_ids">
      <purpose>Encontrar IDs de referência usados</purpose>
      <regex>citacoes:\s*\["([^"]+)"</regex>
    </pattern>
  </grep_patterns>

  <audit_workflow>
    <step order="1">
      <action>Ler arquivo de dados alvo</action>
      <command>Read lib/data/rastreamentos.ts</command>
    </step>
    <step order="2">
      <action>Identificar claims sem citação</action>
      <command>Analisar texto com regex_patterns</command>
    </step>
    <step order="3">
      <action>Ler referências existentes</action>
      <command>Read lib/data/references.ts</command>
    </step>
    <step order="4">
      <action>Validar DOIs existentes</action>
      <command>WebFetch CrossRef API para cada DOI</command>
    </step>
    <step order="5">
      <action>Buscar citações para gaps</action>
      <command>WebFetch PubMed API com termos do contexto</command>
    </step>
    <step order="6">
      <action>Adicionar citações e referências</action>
      <command>Edit arquivos de dados e references.ts</command>
    </step>
    <step order="7">
      <action>Verificar build</action>
      <command>npm run build</command>
    </step>
  </audit_workflow>
</tool_usage>
