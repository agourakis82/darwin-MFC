{
  "name": "medical-education-sota-backend",
  "version": "1.0.0",
  "description": "Backend para Sistema de Educação Médica State-of-the-Art 2025-2026",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "prisma migrate reset",
    "docker:build": "docker build -t medical-education-sota-backend .",
    "docker:run": "docker run -p 8002:8002 medical-education-sota-backend"
  },
  "keywords": [
    "medical",
    "education",
    "ai",
    "llm",
    "adaptive-learning",
    "medical-students",
    "brazil",
    "enamed",
    "residency"
  ],
  "author": "Medical Education SOTA Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "express-session": "^1.17.3",
    "connect-redis": "^7.1.0",
    "redis": "^4.6.10",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "prisma": "^5.7.0",
    "@prisma/client": "^5.7.0",
    "mongoose": "^8.0.3",
    "mongodb": "^6.3.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.1",
    "redis": "^4.6.10",
    "axios": "^1.6.2",
    "openai": "^4.20.1",
    "@anthropic-ai/sdk": "^0.6.2",
    "uuid": "^9.0.1",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "express-winston": "^4.2.0",
    "pino": "^8.16.2",
    "pino-http": "^8.5.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0",
    "node-cron": "^3.0.3",
    "ioredis": "^5.3.2",
    "bull": "^4.12.2",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/express-session": "^1.17.10",
    "@types/uuid": "^9.0.7",
    "@types/crypto": "^1.0.2",
    "@types/node-cron": "^3.0.11"
  },
  "devDependencies": {
    "typescript": "^5.3.2",
    "tsx": "^4.6.2",
    "@types/node": "^20.10.4",
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.16",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "nodemon": "^3.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/bull": "^4.10.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/medical-education-sota/backend.git"
  },
  "bugs": {
    "url": "https://github.com/medical-education-sota/backend/issues"
  },
  "homepage": "https://github.com/medical-education-sota/backend#readme"
}