# Configurações do Ambiente - Sistema de Educação Médica SOTA 2025-2026

# ===== CONFIGURAÇÕES GERAIS =====
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# ===== BANCO DE DADOS =====
DATABASE_URL=postgresql://postgres:password@localhost:5432/medical_education_sota
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=medical_education_sota
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# ===== REDIS (Cache e Sessions) =====
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== JWT E AUTENTICAÇÃO =====
JWT_SECRET=medical_education_sota_jwt_secret_2025
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=medical_education_refresh_secret_2025
JWT_REFRESH_EXPIRES_IN=7d

# ===== LLM E IA =====
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HUGGING_FACE_TOKEN=your_hugging_face_token_here

# ===== CONFIGURAÇÕES SOTA =====
# Deep Learning Models
TENSORFLOW_MODEL_PATH=./models/medical_ai/
PYTORCH_MODEL_PATH=./models/pytorch_medical/
TRANSFORMERS_MODEL_PATH=./models/transformers/

# AI/ML Services
AI_SERVICE_PORT=8001
AI_MODEL_CACHE_SIZE=1000
AI_BATCH_SIZE=32
AI_MAX_CONCURRENT_REQUESTS=100

# ===== BLOCKCHAIN =====
BLOCKCHAIN_PROVIDER_URL=https://polygon-mumbai.infura.io/v3/
BLOCKCHAIN_PRIVATE_KEY=your_blockchain_private_key_here
SMART_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890

# ===== LMS INTEGRATION =====
MOODLE_API_URL=https://your-university.moodle.com
MOODLE_API_TOKEN=your_moodle_api_token
CANVAS_API_URL=https://your-university.instructure.com
CANVAS_API_TOKEN=your_canvas_api_token

# ===== FEDERATED LEARNING =====
FEDERATED_LEARNING_ENABLED=true
FEDERATED_LEARNING_AGGREGATION_METHOD=secure_sum
FEDERATED_LEARNING_PRIVACY_BUDGET=1.0

# ===== PRIVACIDADE E SEGURANÇA =====
# LGPD/GDPR Compliance
DATA_RETENTION_PERIOD=7y
ANONYMIZATION_ENABLED=true
DIFFERENTIAL_PRIVACY_EPSILON=1.0
ENCRYPTION_KEY=your_encryption_key_here

# ===== WEBSOCKET =====
SOCKET_IO_PORT=8002
SOCKET_IO_CORS_ORIGINS=http://localhost:3000,https://medical-edu-sota.com

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== MONITORING =====
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
JAEGER_COLLECTOR_PORT=14268

# ===== EMAIL (Notificações) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ===== STORAGE =====
# AWS S3 ou similar
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET=medical-education-content

# ===== VR/AR =====
VR_API_URL=http://localhost:8080
VR_SIMULATION_TIMEOUT=300000

# ===== ANALYTICS =====
ANALYTICS_ENABLED=true
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL=5000

# ===== DESENVOLVIMENTO =====
DEBUG=medical-education:*
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===== PRODUÇÃO =====
# SSL/TLS
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem

# Load Balancer
LOAD_BALANCER_URL=https://api.medical-edu-sota.com

# ===== MEDICAL SPECIFIC =====
# Brazilian Medical Guidelines
CFM_API_URL=https://sistemas.cfm.org.br/api/
SBH_API_URL=https://sbh.org.br/api/
SBC_API_URL=https://sbc.org.br/api/

# Medical Knowledge Base
MEDICAL_KB_PATH=./knowledge_base/medical/
CURRICULUM_PATH=./curriculum/bncc_medicina/
ENAMED_PATTERNS_PATH=./patterns/enamed/