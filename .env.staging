# Darwin-MFC Staging Environment Configuration
# ==============================================

# Environment
NODE_ENV=production
APP_ENV=staging
APP_VERSION=1.0.0-staging

# Application
APP_PORT=3000
APP_DEBUG=false
APP_LOG_LEVEL=info

# Supabase (Staging)
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# API Configuration
NEXT_PUBLIC_API_URL=https://staging-api.mfc.agourakis.med.br
SUPABASE_API_URL=https://your-staging-project.supabase.co/rest/v1

# Keycloak OAuth2 (Staging)
NEXT_PUBLIC_KEYCLOAK_URL=https://staging-auth.mfc.agourakis.med.br
NEXT_PUBLIC_KEYCLOAK_REALM=darwin-mfc-staging
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=darwin-mfc-web-staging

# Search Service
NEXT_PUBLIC_SEARCH_URL=https://staging-search.mfc.agourakis.med.br
NEXT_PUBLIC_SEARCH_API_KEY=staging-search-key

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_STAGING_PASSWORD}

# Database (Production-grade staging)
POSTGRES_PORT=5432
POSTGRES_DB=darwin_mfc_staging
POSTGRES_USER=darwin_staging
POSTGRES_PASSWORD=${POSTGRES_STAGING_PASSWORD}

# JWT Secret
JWT_SECRET=${JWT_STAGING_SECRET}

# Feature Flags
NEXT_PUBLIC_ENABLE_AUTH=true
NEXT_PUBLIC_ENABLE_COMMUNITY=true
NEXT_PUBLIC_ENABLE_LEARNING=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_DEBUG=false

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=${GRAFANA_STAGING_ADMIN_USER}
GRAFANA_ADMIN_PASSWORD=${GRAFANA_STAGING_ADMIN_PASSWORD}
LOKI_PORT=3100

# SSL Configuration
NGINX_PORT=80
NGINX_SSL_PORT=443
SSL_CERT_PATH=/etc/nginx/ssl/staging.crt
SSL_KEY_PATH=/etc/nginx/ssl/staging.key

# Build Configuration
BUILD_TARGET=staging
NEXT_TELEMETRY_DISABLED=1

# Security
CORS_ORIGIN=https://staging.mfc.agourakis.med.br
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Health Checks
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=3
HEALTH_CHECK_RETRIES=3

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30