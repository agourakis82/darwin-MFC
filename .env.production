# Darwin-MFC Production Environment Configuration
# ================================================

# Environment
NODE_ENV=production
APP_ENV=production
APP_VERSION=1.0.0

# Application
APP_PORT=3000
APP_DEBUG=false
APP_LOG_LEVEL=warn

# Supabase (Production)
NEXT_PUBLIC_SUPABASE_URL=https://your-prod-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_PROD_ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_PROD_SERVICE_ROLE_KEY}

# API Configuration
NEXT_PUBLIC_API_URL=https://api.mfc.agourakis.med.br
SUPABASE_API_URL=https://your-prod-project.supabase.co/rest/v1

# Keycloak OAuth2 (Production)
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.mfc.agourakis.med.br
NEXT_PUBLIC_KEYCLOAK_REALM=darwin-mfc-prod
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=darwin-mfc-web-prod

# Search Service
NEXT_PUBLIC_SEARCH_URL=https://search.mfc.agourakis.med.br
NEXT_PUBLIC_SEARCH_API_KEY=${SEARCH_PROD_API_KEY}

# Redis (Production)
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PROD_PASSWORD}

# Database (Production)
POSTGRES_PORT=5432
POSTGRES_DB=darwin_mfc_prod
POSTGRES_USER=darwin_prod
POSTGRES_PASSWORD=${POSTGRES_PROD_PASSWORD}

# JWT Secret
JWT_SECRET=${JWT_PROD_SECRET}

# Feature Flags
NEXT_PUBLIC_ENABLE_AUTH=true
NEXT_PUBLIC_ENABLE_COMMUNITY=true
NEXT_PUBLIC_ENABLE_LEARNING=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_DEBUG=false

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=${GRAFANA_PROD_ADMIN_USER}
GRAFANA_ADMIN_PASSWORD=${GRAFANA_PROD_ADMIN_PASSWORD}
LOKI_PORT=3100

# SSL Configuration
NGINX_PORT=80
NGINX_SSL_PORT=443
SSL_CERT_PATH=/etc/nginx/ssl/prod.crt
SSL_KEY_PATH=/etc/nginx/ssl/prod.key
SSL_CERT_DOMAIN=mfc.agourakis.med.br

# Build Configuration
BUILD_TARGET=production
NEXT_TELEMETRY_DISABLED=1

# Security
CORS_ORIGIN=https://mfc.agourakis.med.br
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=60
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true

# Health Checks
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=3
HEALTH_CHECK_RETRIES=3

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=90
BACKUP_ENCRYPTION_KEY=${BACKUP_ENCRYPTION_KEY}

# Performance
COMPRESSION_ENABLED=true
CACHE_TTL=3600
MAX_REQUEST_SIZE=10MB

# Error Tracking
SENTRY_DSN=${SENTRY_DSN}
SENTRY_ENVIRONMENT=production

# CDN
CDN_URL=https://cdn.mfc.agourakis.med.br
STATIC_ASSETS_CDN=true

# Rate Limiting
API_RATE_LIMIT=100
UPLOAD_RATE_LIMIT=10
SEARCH_RATE_LIMIT=30

# SSL/TLS
TLS_VERSION=1.3
HSTS_MAX_AGE=31536000
HTTPS_REDIRECT=true